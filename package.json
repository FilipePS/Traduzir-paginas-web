{
  "name": "translate-web-pages",
  "version": "1.0.0",
  "browserslist": [
    "firefox 63",
    "chrome 70"
  ],
  "scripts": {
    "build": "npx gulp",
    "build:local-sourcemaps": "npx gulp --local-sourcemaps",
    "build:sign": "npx gulp --sign",
    "polyfill": "npx webpack --entry=./polyfill.js --output-path=./src/lib --output-filename=polyfill.js -d inline-source-map"
  },
  "dependencies": {
    "core-js": "^3.26.1",
    "htmlparser2": "^10.0.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^8.0.2",
    "@types/chrome": "latest",
    "@types/firefox-webext-browser": "latest",
    "crx3": "^2.0.0",
    "gulp": "^5.0.0",
    "gulp-babel": "^8.0.0",
    "gulp-sourcemaps": "^2.6.5",
    "gulp-zip": "^5.1.0",
    "node-file-dialog": "^1.0.3",
    "webpack": "^5.105.0",
    "webpack-cli": "^7.2.2"
  },
  "allowScripts": {
    "core-js@3.50.0": true,
    "es5-ext": false
  }
}
